# Chép file này thành .env rồi sửa giá trị.

# PostgreSQL (docker compose up -d db). Bỏ trống dòng này để dùng SQLite khi thử nhanh.
DATABASE_URL=postgresql+psycopg://healthwatch:healthwatch@localhost:5432/healthwatch

# Chuỗi bí mật ký JWT — đổi thành chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
TIMEZONE=Asia/Ho_Chi_Minh

# Firebase Cloud Messaging: tải file service-account JSON từ Firebase Console
# (Project settings > Service accounts > Generate new private key)
FIREBASE_CREDENTIALS=

# SMS: console (in ra log, dùng khi thử) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Địa chỉ server mà người nhà mở được (đưa vào nội dung SMS)
PUBLIC_BASE_URL=http://192.168.1.10:8000
DEVICE_OFFLINE_MIN=30
